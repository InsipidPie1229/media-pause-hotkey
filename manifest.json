{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.2.0",
  "minimum_chrome_version": "119",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-recent-media": {
      "description": "__MSG_commandDescription__",
      "global": true
    },
    "volume-up": {
      "description": "__MSG_commandVolumeUp__",
      "global": true
    },
    "volume-down": {
      "description": "__MSG_commandVolumeDown__",
      "global": true
    },
    "speed-up": {
      "description": "__MSG_commandSpeedUp__",
      "global": true
    },
    "speed-down": {
      "description": "__MSG_commandSpeedDown__",
      "global": true
    },
    "speed-reset": {
      "description": "__MSG_commandSpeedReset__",
      "global": true
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
